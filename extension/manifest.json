{
  "manifest_version": 3,
  "name": "Interfood kosársegéd",
  "version": "0.1.0",
  "description": "A napi fo ajanlatot es ket alternativat teszi a kosarba; rendelest nem veglegesit.",
  "key": "",
  "permissions": [
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "https://rendel.interfood.hu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://rendel.interfood.hu/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://rendel.interfood.hu/*"
      ],
      "js": [
        "core.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}